<?xml version="1.0"?>
<sdf version="1.8">
  <world name="m2_contact_fixture">
    <physics name="steps" type="ignored"><max_step_size>0.004</max_step_size><real_time_factor>1</real_time_factor></physics>
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="libm2_contact_monitor.so" name="opticore::M2ContactMonitor"><robot>amr1</robot></plugin>
    <model name="ground_plane"><static>true</static><link name="link"><collision name="floor">
      <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
    </collision></link></model>
    <model name="amr1"><pose>0 0 0.11 0 0 0</pose><link name="base_link">
      <inertial><mass>2</mass><inertia><ixx>0.1</ixx><iyy>0.1</iyy><izz>0.1</izz></inertia></inertial>
      <collision name="chassis"><pose>0 0 0.08 0 0 0</pose><geometry><box><size>0.60 0.40 0.16</size></box></geometry></collision>
      <collision name="wheel_pad"><geometry><box><size>0.38 0.30 0.2</size></box></geometry></collision>
    </link></model>
    <model name="rack_fixture"><static>true</static><pose>2 0 0.3 0 0 0</pose><link name="link">
      <collision name="shape"><geometry><box><size>0.25 1 0.6</size></box></geometry></collision>
    </link></model>
    <model name="m2_mission_obstacle"><static>true</static><pose>-2 0 0.3 0 0 0</pose><link name="link">
      <collision name="shape"><geometry><box><size>0.25 1 0.6</size></box></geometry></collision>
    </link></model>
  </world>
</sdf>
